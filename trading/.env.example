# Copy to .env (never commit the real one).
# Binance USDⓈ-M futures API key with "Enable Futures" permission. For testnet use keys from https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# paper | testnet | live  (live also needs `munder-trader run --yes`)
MT_TRADING_ENV=paper

# Hard leverage ceiling (everything else is automatic)
MT_RISK__MAX_LEVERAGE=100

# Optional LLM for the agent debates (leave empty → rule-based committee)
# MT_LLM__PROVIDER=openai
# OPENAI_API_KEY=
# MT_LLM__QUICK_MODEL=gpt-4o-mini
# MT_LLM__DEEP_MODEL=gpt-4o
# For Ollama: MT_LLM__PROVIDER=ollama  MT_LLM__BASE_URL=http://localhost:11434/v1  MT_LLM__QUICK_MODEL=llama3.1

# Optional Telegram notifications
# MT_NOTIFY__TELEGRAM_BOT_TOKEN=
# MT_NOTIFY__TELEGRAM_CHAT_ID=
